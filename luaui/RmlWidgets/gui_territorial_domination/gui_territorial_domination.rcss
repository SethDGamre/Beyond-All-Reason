body {
	pointer-events: none;
	font-family: Exo 2;
}

.td-panel {
	position: absolute;
	display: block;
	width: 240dp;
	height: 110dp;
	box-sizing: border-box;
	background-color: rgba(30, 33, 38, 238);
	border: 1dp rgba(8, 10, 13, 245);
	border-radius: 6dp;
	overflow: hidden;
	clip: always;
	pointer-events: auto;
	cursor: move;
	z-index: 1000;
	transition: height 0.18s cubic-out, top 0.18s cubic-out;
}

.td-panel.expanded {
	height: 204dp;
}

.td-panel.dragging {
	transition: height 0s, top 0s;
}

.td-panel-outer-halo {
	position: absolute;
	display: block;
	width: 240dp;
	height: 110dp;
	border-radius: 6dp;
	opacity: 0;
	pointer-events: none;
	z-index: 999;
	transition: height 0.18s cubic-out, top 0.18s cubic-out;
}

.td-panel-outer-halo.expanded {
	height: 204dp;
}

.td-panel-outer-halo.dragging {
	transition: height 0s, top 0s;
}

.td-panel-outer-halo.origin {
	box-shadow: 0dp 0dp 9dp 2dp rgba(255, 255, 255, 155), 0dp 0dp 20dp 5dp rgba(255, 255, 255, 70);
	opacity: 1;
}

.td-panel-outer-halo.first-place {
	box-shadow: 0dp 0dp 9dp 2dp rgba(62, 235, 96, 145), 0dp 0dp 20dp 5dp rgba(42, 215, 78, 65);
	opacity: 1;
}

.td-panel-outer-halo.danger {
	box-shadow: 0dp 0dp 10dp 2dp rgba(245, 45, 45, 165), 0dp 0dp 22dp 6dp rgba(225, 25, 25, 75);
	animation: 2.4s cubic-in-out infinite td-danger-halo-pulse;
}

.td-panel-texture {
	position: absolute;
	display: block;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image("/luaui/images/stripes-small.png" repeat);
	image-color: rgba(45, 49, 56, 74);
	pointer-events: none;
	z-index: 0;
}

.td-panel-gradient {
	position: absolute;
	display: block;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(#FFFFFF24 #0000008A);
	pointer-events: none;
	z-index: 1;
}

.td-panel-halo {
	position: absolute;
	display: block;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	border-radius: 6dp;
	opacity: 0;
	pointer-events: none;
	z-index: 20;
}

.td-panel-halo.origin {
	box-shadow: inset 0dp 0dp 14dp 3dp rgba(255, 255, 255, 105);
	opacity: 1;
}

.td-panel-halo.first-place {
	box-shadow: inset 0dp 0dp 14dp 3dp rgba(62, 235, 96, 95);
	opacity: 1;
}

.td-panel-halo.danger {
	box-shadow: inset 0dp 0dp 15dp 3dp rgba(235, 35, 35, 115);
	animation: 2.4s cubic-in-out infinite td-danger-halo-pulse;
}

@keyframes td-danger-halo-pulse {
	0% {
		opacity: 0.42;
	}
	50% {
		opacity: 1;
	}
	100% {
		opacity: 0.42;
	}
}

.td-distribution {
	position: absolute;
	display: flex;
	left: 10dp;
	top: 11.167dp;
	width: 218dp;
	height: 8.667dp;
	box-sizing: border-box;
	background-color: rgba(8, 10, 13, 220);
	border: 1dp rgba(255, 255, 255, 55);
	border-radius: 3dp;
	overflow: hidden;
	clip: always;
	cursor: pointer;
	z-index: 3;
}

.td-distribution:hover {
	border-color: rgba(255, 255, 255, 145);
}

.td-distribution-segment {
	position: relative;
	display: block;
	height: 100%;
	min-width: 2dp;
	flex-shrink: 0;
	opacity: 0.9;
}

.td-distribution-segment:hover {
	opacity: 1;
}

.td-bar-gloss {
	position: absolute;
	display: block;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(#FFFFFF50 #00000052);
	pointer-events: none;
	z-index: 5;
}

.td-horizontal-score {
	position: absolute;
	display: block;
	left: 10dp;
	top: 36dp;
	width: 218dp;
	height: 24dp;
	box-sizing: border-box;
	background-color: rgba(7, 9, 12, 225);
	border: 1dp rgba(255, 255, 255, 65);
	border-radius: 4dp;
	overflow: hidden;
	clip: always;
	cursor: move;
	z-index: 3;
}

.td-horizontal-score:hover {
	border-color: rgba(255, 255, 255, 155);
}

.td-horizontal-projected,
.td-horizontal-actual {
	position: absolute;
	display: block;
	left: 0;
	top: 0;
	height: 100%;
}

.td-horizontal-projected {
	decorator: image("/luaui/images/stripes-small.png" repeat);
	image-color: rgba(255, 255, 255, 38);
	z-index: 1;
}

.td-horizontal-actual {
	decorator: vertical-gradient(#FFFFFF55 #00000055);
	z-index: 2;
}

.td-expanded-chart {
	position: absolute;
	display: block;
	left: 10dp;
	top: 9dp;
	width: 218dp;
	height: 152dp;
	box-sizing: border-box;
	background-color: rgba(8, 10, 13, 160);
	border: 1dp rgba(255, 255, 255, 38);
	border-radius: 4dp;
	overflow: hidden;
	clip: always;
	z-index: 2;
}

.td-vertical-scroll {
	position: absolute;
	display: block;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	overflow-x: hidden;
	overflow-y: hidden;
	z-index: 2;
}

.td-vertical-scroll.overflowing {
	overflow-x: auto;
}

.td-vertical-content {
	position: relative;
	display: flex;
	height: 146dp;
	padding: 0 3dp;
	box-sizing: border-box;
	justify-content: space-evenly;
}

.td-vertical-slot {
	position: relative;
	display: block;
	width: 42dp;
	height: 146dp;
	flex-shrink: 0;
	box-sizing: border-box;
	cursor: pointer;
}

.td-vertical-slot.eliminated {
	opacity: 0.38;
}

.td-vertical-rank {
	position: absolute;
	display: block;
	left: 0;
	top: 0;
	width: 100%;
	height: 16dp;
	color: rgba(224, 228, 235, 235);
	font-size: 13dp;
	font-weight: bold;
	text-align: center;
	font-effect: outline(1dp rgba(0, 0, 0, 220));
}

.td-vertical-track {
	position: absolute;
	display: block;
	left: 50%;
	top: 16dp;
	width: 18.667dp;
	height: 112dp;
	box-sizing: border-box;
	background-color: rgba(4, 5, 7, 230);
	border: 1dp rgba(255, 255, 255, 48);
	border-radius: 3dp;
	overflow: hidden;
	clip: always;
	cursor: pointer;
	transform: translateX(-50%);
}

.td-vertical-track:hover {
	border-color: rgba(255, 255, 255, 170);
}

.td-vertical-projected,
.td-vertical-actual {
	position: absolute;
	display: block;
	left: 0;
	bottom: 0;
	width: 100%;
}

.td-vertical-projected {
	decorator: image("/luaui/images/stripes-small.png" repeat);
	image-color: rgba(255, 255, 255, 40);
	z-index: 1;
}

.td-vertical-actual {
	decorator: vertical-gradient(#FFFFFF55 #00000055);
	z-index: 2;
}

.td-vertical-gloss {
	position: absolute;
	display: block;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: horizontal-gradient(#FFFFFF30 #00000032);
	pointer-events: none;
	z-index: 3;
}

.td-vertical-score {
	position: absolute;
	display: block;
	left: 0;
	top: 129dp;
	width: 100%;
	height: 17dp;
	color: #ffffff;
	font-size: 13dp;
	font-weight: bold;
	text-align: center;
	font-effect: outline(1dp rgba(0, 0, 0, 230));
	white-space: nowrap;
}

.td-deadline-marker {
	position: absolute;
	display: block;
	left: 0;
	width: 100%;
	height: 1dp;
	pointer-events: none;
	z-index: 6;
}

.td-deadline-hotspot {
	position: absolute;
	display: block;
	left: 0;
	top: -6dp;
	width: 100%;
	height: 13dp;
	pointer-events: auto;
	cursor: help;
}

.td-deadline-line {
	position: absolute;
	display: block;
	left: 0;
	top: 6dp;
	width: 100%;
	height: 1dp;
	background-color: rgba(255, 48, 48, 245);
	pointer-events: none;
}

.td-deadline-label {
	position: absolute;
	display: block;
	left: 2dp;
	width: 22dp;
	height: 18dp;
	color: #ff3030;
	font-size: 15dp;
	font-weight: bold;
	line-height: 18dp;
	text-align: left;
	font-effect: outline(1dp rgba(0, 0, 0, 245));
	pointer-events: auto;
	cursor: help;
}

.td-footer {
	position: absolute;
	display: flex;
	left: 10dp;
	top: 70dp;
	width: 218dp;
	height: 32dp;
	box-sizing: border-box;
	background-color: rgba(8, 10, 13, 145);
	border: 1dp rgba(255, 255, 255, 34);
	border-radius: 4dp;
	z-index: 3;
}

.td-panel.expanded .td-footer {
	top: 165dp;
}

.td-footer-score,
.td-footer-countdown,
.td-footer-target {
	position: relative;
	display: block;
	height: 30dp;
	box-sizing: border-box;
	padding-top: 4dp;
	color: #ffffff;
	font-size: 18dp;
	font-weight: bold;
	font-effect: outline(1dp rgba(0, 0, 0, 235));
	white-space: nowrap;
}

.td-footer-score {
	width: 82dp;
	padding-left: 5dp;
	text-align: left;
	cursor: help;
}

.td-footer-countdown {
	width: 60dp;
	text-align: center;
	cursor: help;
}

.td-footer-target {
	width: 74dp;
	padding-right: 5dp;
	text-align: right;
	cursor: help;
}

.td-footer-target.deadline {
	color: #ff3030;
}

.td-footer-icon {
	display: inline;
	margin-right: 2dp;
}

.td-footer-countdown.warning {
	color: #ff4d4d;
	animation: 0.5s cubic-in-out infinite td-warning-pulse;
}

@keyframes td-warning-pulse {
	0% {
		color: #ff7575;
		transform: scale(1.04);
	}
	100% {
		color: #d62f2f;
		transform: scale(1);
	}
}

.td-vertical-scroll scrollbarhorizontal {
	display: none;
	height: 3.333dp;
	margin-top: 1dp;
}

.td-vertical-scroll.overflowing scrollbarhorizontal {
	display: block;
}

.td-vertical-scroll scrollbarhorizontal slidertrack {
	background-color: rgba(255, 255, 255, 12);
	border-radius: 3dp;
}

.td-vertical-scroll scrollbarhorizontal sliderbar {
	min-width: 24dp;
	background-color: rgba(255, 255, 255, 65);
	border-radius: 3dp;
}

.td-vertical-scroll scrollbarhorizontal sliderbar:hover {
	background-color: rgba(255, 205, 80, 205);
}

.td-vertical-scroll scrollbarhorizontal sliderbar:active {
	background-color: rgba(255, 205, 80, 255);
}

.td-tooltip {
	position: fixed;
	display: block;
	width: 300dp;
	box-sizing: border-box;
	padding: 7dp 9dp;
	background-color: rgba(14, 17, 22, 247);
	border: 1dp rgba(255, 255, 255, 82);
	border-radius: 4dp;
	color: rgba(236, 239, 244, 255);
	font-size: 17dp;
	font-weight: bold;
	font-effect: outline(1dp rgba(0, 0, 0, 230));
	pointer-events: none;
	z-index: 3000;
	decorator: vertical-gradient(#FFFFFF1F #00000070);
}

.td-tooltip-score {
	display: block;
}

.td-tooltip-row,
.td-tooltip-player {
	display: block;
	height: 22dp;
}

.td-tooltip-player {
	display: block;
	white-space: nowrap;
}

.td-tooltip-simple {
	display: block;
	height: 22dp;
	text-align: center;
	white-space: nowrap;
}

.td-tooltip-leader-row {
	display: flex;
	width: 100%;
	height: 22dp;
}

.td-tooltip-leader-row > span:first-child {
	display: block;
	flex: 1;
}

.td-tooltip-color {
	display: block;
	width: 14dp;
	height: 14dp;
	margin-top: 3dp;
	border: 1dp rgba(255, 255, 255, 130);
}

.td-popup {
	position: fixed;
	display: flex;
	left: 0;
	top: 0;
	width: 100vw;
	height: 100vh;
	justify-content: center;
	align-items: center;
	pointer-events: none;
	z-index: 2500;
}

.td-popup-content {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 6dp;
	padding: 20dp;
	box-sizing: border-box;
	background-color: transparent;
	border-width: 0dp;
	border-color: transparent;
	border-radius: 0dp;
	text-align: center;
	animation: 0.28s cubic-out 1 td-popup-in;
}

@keyframes td-popup-in {
	0% {
		opacity: 0;
		transform: translateY(-22dp) scale(0.96);
	}
	100% {
		opacity: 1;
		transform: translateY(0dp) scale(1);
	}
}

.td-popup-title {
	display: block;
	color: #ffffff;
	font-size: 54dp;
	font-weight: bold;
	font-effect: outline(4dp rgba(0, 0, 0, 140));
	margin-bottom: 12dp;
	width: 100%;
	text-align: center;
}

.td-popup-rate,
.td-popup-deadline {
	display: block;
	color: #ffffff;
	font-size: 24dp;
	font-weight: bold;
	font-effect: outline(3dp rgba(0, 0, 0, 140));
	width: 100%;
	text-align: center;
}

.td-popup-rate {
	margin-bottom: 8dp;
}
